.DS_Store

# Nested standalone git repositories — kept locally for cross-reference,
# tracked independently in their own remotes.
related/

# Large submission video bundles (mirrored to Vimeo; archived locally only).
docs/lacma-2026/submission/video/

# Event-specific deployment configs (venue network layout, node coordinates,
# per-event runners). Kept locally; not part of the general codebase.
code/config/*_glo.*
code/config/networks_glo.csv
code/input_controller/run_voice_glo.py

# Scratch verification probe (marked local-only in its own docstring).
# The rest of code/tools/bi-check/ is tracked.
code/tools/bi-check/probe_soft_prefix.py

# Per-device audio check WAVs (~20MB, deployment material - not part of the codebase).
code/bi_audio_check/

# MANS cluster map holds the real device IDs filled in on site; example is tracked.
code/config/cluster_map_mans.csv

# Monitor runtime logs, generated per run on the host.
code/logs/
